{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MaaHub: Build (Release)",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "args": ["release"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$msCompile"],
            "detail": "MSVC  release 构建 build\\MaaHub.exe"
        },
        {
            "label": "MaaHub: Build (Debug)",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "args": ["debug"],
            "group": "build",
            "problemMatcher": ["$msCompile"],
            "detail": "MSVC debug 构建（/Zi /Od，可断点）"
        },
        {
            "label": "MaaHub: Self-Check (no game)",
            "type": "shell",
            "command": "${workspaceFolder}\\build\\MaaHub.exe",
            "args": ["--check"],
            "group": "test",
            "problemMatcher": [],
            "detail": "干跑自检：加载核心、拉起全部执行器 worker、读取任务目录"
        },
        {
            "label": "MaaHub: Test (headless)",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}\\tests\\headless_tests.py"],
            "group": "test",
            "problemMatcher": [],
            "detail": "无头测试：启动性能/执行器/核心内部管理/多执行器共享核心（不创建窗口）"
        },
        {
            "label": "MaaHub: Bench (startup)",
            "type": "shell",
            "command": "${workspaceFolder}\\build\\MaaHub.exe",
            "args": ["--startup-bench"],
            "group": "test",
            "problemMatcher": [],
            "detail": "启动性能基准：first_paint 应 < 200ms（无窗口）"
        }
    ]
}
