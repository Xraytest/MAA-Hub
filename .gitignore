# 构建产物
build/
*.obj
*.exe
*.pdb
*.ilk
*.exp

# 内部管理的核心（MaaHub 自行拉取/导入，体积大且可按需重建）
cores/

# 运行时状态与本机配置（含路径/账号信息，不提交）
state/
state-*/
config.json

# 下载缓存
_download/

# VS Code / IDE
.vs/

# 系统与编辑器临时文件
Thumbs.db
desktop.ini
._*
*.tmp.*
*.log
maahub-crash.log

# 沙盒探针（本地临时，勿提交）
_sandbox/

# 面板验收与审计截图（本地产物，勿提交）
docs/audit-*.png
docs/final-*.png
docs/*.png

# Python 缓存
__pycache__/
*.pyc

# local temp compare dir (probe scripts/screenshots, do not commit)
_cmp/

# GitHub 访问令牌（本地凭据，绝不提交）
.github-token*
